{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "route1": {
        "ClusterId": "cluster1",
        "Match": {
          "Path": "service1/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "service1" }
        ]
      },
      "route2": {
        "ClusterId": "cluster2",
        "Match": {
          "Path": "service2/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "service2" }
        ]
      },
      "route3": {
        "ClusterId": "cluster3",
        "Match": {
          "Path": "service3/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "service3" }
        ]
      }
    },
    "Clusters": {
      "cluster1": {
        "Destinations": {
          "destination1": {
            "Address": "http://service1"
          }
        }
      },
      "cluster2": {
        "Destinations": {
          "destination1": {
            "Address": "http://service2"
          }
        }
      },
      "cluster3": {
        "Destinations": {
          "destination1": {
            "Address": "http://service3"
          }
        }
      }
    }
  }
}
